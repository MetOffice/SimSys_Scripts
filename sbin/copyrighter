#!/usr/bin/env bash
# -----------------------------------------------------------------------------
# (C) Crown copyright Met Office. All rights reserved.
# The file LICENCE, distributed with this code, contains details of the terms
# under which the code may be used.
# -----------------------------------------------------------------------------

# copyrighter - insert or update the Met Office Crown copyright header in a
# file, or in every file under a directory.
#
# Usage: copyrighter [-t TYPE] [-r] [-n] [-h] <file-or-directory> [path...]

set -euo pipefail

readonly BORDER="-----------------------------------------------------------------------------"
readonly MARKER="Crown copyright Met Office"
readonly SUPPORTED_TYPES="python fortran cpp c shell rst markdown perl yaml json"

# status symbols used to decorate every "copyrighter:" message
readonly SYM_ADDED="+"
readonly SYM_UPDATED="~"
readonly SYM_UNCHANGED="="
readonly SYM_WARN="!"
readonly SYM_INFO="i"
readonly SYM_ERROR="✗"
readonly SYM_SUMMARY="»"

FORCED_TYPE=""
RECURSIVE=0
DRY_RUN=0
ADDED_COUNT=0
UPDATED_COUNT=0
UNCHANGED_COUNT=0
SKIPPED_COUNT=0
HEADER_LINES=()
NEEDS_HEADER_FILES=()

# prefer fd when available for directory traversal, falling back to find
# (ripgrep is not used for binary-file detection, see is_text_file)
HAVE_FD=0
if command -v fd >/dev/null 2>&1; then HAVE_FD=1; fi

usage() {
    cat <<EOF
Usage: ${0##*/} [options] <file-or-directory> [path...]

Insert a Met Office Crown copyright header at the top of a file (after any
shebang line), or into every file under a directory. If a copyrighter header
is already present it is updated in place rather than duplicated.

Options:
  -t, --type TYPE    Force the file type instead of auto-detecting it.
                     One of: ${SUPPORTED_TYPES}
  -r, --recursive, --full
                     When a directory is given, descend into every nested
                     subdirectory (no depth limit). Without this, only the
                     files directly inside the given directory are processed.
  -n, --dry-run, --check
                     Report what would change without modifying any file.
  -h, --help         Show this help message.

File types are auto-detected from the file extension, falling back to the
shebang line for extension-less scripts. JSON has no native comment syntax,
so headers are inserted as "//" line comments (JSONC-style); a warning is
printed whenever this happens.

Exits non-zero if any file needed a header added or updated, or if a path
could not be processed - useful for CI checks with --dry-run.
EOF
}

# detect_type FILE - auto-detect a file's type from its extension, falling
# back to the shebang line when the extension is missing or unrecognised.
detect_type() {
  local file="$1" ext first_line

  ext="${file##*.}"
  [[ "$file" == *.* && "$ext" != "$file" ]] || ext=""
  ext="${ext,,}"

  case "$ext" in
    bash|ksh|sh) echo "shell"; return ;;
    c++|cc|cpp|cxx|h++|hh|hpp|hxx) echo "cpp"; return ;;
    c|h) echo "c"; return ;;
    f|f77|f90|f95|f03|f08|for) echo "fortran"; return ;;
    json) echo "json"; return ;;
    markdown|md) echo "markdown"; return ;;
    pl|pm) echo "perl"; return ;;
    py) echo "python"; return ;;
    rst) echo "rst"; return ;;
    yaml|yml) echo "yaml"; return ;;
  esac

  first_line=$(head -n 1 -- "$file" 2>/dev/null || true)
  case "$first_line" in
    '#!'*python*) echo "python"; return ;;
    '#!'*perl*) echo "perl"; return ;;
    '#!'*bash|'#!'*/sh|'#!'*ksh) echo "shell"; return ;;
  esac

  echo ""
}

# generate_header TYPE - populate the HEADER_LINES array with the
# comment-style-appropriate copyright block for TYPE.
generate_header() {
  local type="$1"
  local c_style=0

  # Determine the comment character/style based on file type
  case "$type" in
    python|shell|yaml|perl) local p="#" ;;
    fortran)                local p="!" ;;
    cpp|json)               local p="//" ;;
    c)                      local p=" *" ; c_style=1 ;;
    rst)                    local p="  " ;; # Left-hand indent for body lines
    markdown)               local p=""   ;; # No prefix inside HTML comments
    *)  echo "copyrighter: ${SYM_ERROR} internal error: unknown type '${type}'" >&2
        return 1 ;;
  esac

  # Construct the core body of uniform copyright block
  HEADER_LINES=(
    "${p}${p:+ }${BORDER}"
    "${p}${p:+ }(C) Crown copyright Met Office. All rights reserved."
    "${p}${p:+ }The file LICENCE, distributed with this code, contains details of the terms"
    "${p}${p:+ }under which the code may be used."
    "${p}${p:+ }${BORDER}"
  )

  # Add language-specific wrapping for block-comment formats
  if [ "$type" = "rst" ]; then
    # Replace the first and last lines with the correct RST directive syntax
    HEADER_LINES[0]=".. ${BORDER}"
    HEADER_LINES[4]="   ${BORDER}"
  elif [ "$type" = "markdown" ]; then
    HEADER_LINES=("<!--" "${HEADER_LINES[@]}" "-->")
  elif [ $c_style -eq 1 ]; then
    HEADER_LINES=("/*" "${HEADER_LINES[@]}" " */")
  fi
}

# is_text_file FILE - true if FILE looks like text, false if binary
#
# always uses grep -I: unlike find/rg, ripgrep has no quiet flag that
# reliably reports binary-ness via its exit code (an empty pattern still
# "matches" binary files up to their first NUL byte), so using it here
# risks corrupting binaries by writing a text header into them
is_text_file() {
  grep -Iq '' -- "$1" 2>/dev/null
}

# collect_files DIR RECURSIVE - print a NUL-separated, sorted list of regular
# files under DIR, using fd when available and falling back to find
collect_files() {
  local dir="$1" recursive="$2"

  if ((HAVE_FD)); then
    local fd_opts=(--type f --hidden --no-ignore --absolute-path --print0)
    ((recursive == 0)) && fd_opts+=(--max-depth 1)
    fd "${fd_opts[@]}" . "$dir" | sort -z
  else
    local find_opts=(-type f)
    ((recursive == 0)) && find_opts=(-maxdepth 1 "${find_opts[@]}")
    find "$dir" "${find_opts[@]}" -print0 | sort -z
  fi
}

# Process_file FILE FORCED_TYPE - insert or update the copyright header in FILE.
process_file() {
  local file="$1" forced_type="$2" type

  if ! is_text_file "$file"; then
    echo "copyrighter: ${SYM_WARN} skipping '${file}' (binary file)" >&2
    ((++SKIPPED_COUNT))
    return 0
  fi

  type="${forced_type:-$(detect_type "$file")}"
  if [[ -z "$type" ]]; then
    echo "copyrighter: ${SYM_WARN} skipping '${file}' (unable to determine file type, use --type)" >&2
    ((++SKIPPED_COUNT))
    return 0
  fi

  if [[ "$type" == "json" ]]; then
    echo "copyrighter: ${SYM_INFO} JSON has no comment syntax; '${file}' will become JSONC-style" >&2
  fi

  generate_header "$type"
  local header_count=${#HEADER_LINES[@]}

  local lines=()
  mapfile -t lines < "$file"
  local nlines=${#lines[@]}

  local offset=0
  [[ "${lines[0]:-}" =~ ^#! ]] && offset=1

  # find the relative position of the marker line within our own generated
  # template (not file content), used to anchor the regex built below
  local marker_rel=-1 i
  for ((i = 0; i < header_count; i++)); do
    if [[ "${HEADER_LINES[$i]}" == *"$MARKER"* ]]; then
      marker_rel=$i
      break
    fi
  done

  # match the marker line by prefix + a fixed regex body, tolerating an
  # optional copyright year (e.g. "Met Office 2026."), so a pre-existing
  # header isn't mistaken for new content and duplicated
  local marker_prefix marker_escaped_prefix marker_regex
  marker_prefix="${HEADER_LINES[$marker_rel]%%(C) Crown copyright*}"
  marker_escaped_prefix=$(printf '%s' "$marker_prefix" | sed -e 's/[\\.^$*+?(){}|]/\\&/g')
  marker_regex="^${marker_escaped_prefix}\(C\) Crown copyright Met Office( [0-9]{4})?\. All rights reserved\.$"

  local search_limit=$((offset + 100))
  ((search_limit > nlines)) && search_limit=$nlines

  # scan for every header-like block near the top of the file (not just the
  # first) so that stale duplicates, e.g. left behind by an older version of
  # this script, are all collapsed into a single canonical header
  local block_starts=() block_ends=()
  i=$offset
  while ((i < search_limit)); do
    if [[ "${lines[$i]}" =~ $marker_regex ]]; then
      local candidate_start=$((i - marker_rel))
      local candidate_end=$((candidate_start + header_count - 1))
      if ((candidate_start >= offset && candidate_end < nlines)); then
        block_starts+=("$candidate_start")
        block_ends+=("$candidate_end")
        i=$((candidate_end + 1))
        continue
      fi
    fi
    ((++i))
  done

  local action="Added"
  if ((${#block_starts[@]} == 1)); then
    action="Updated"
    local k matches=1
    for ((k = 0; k < header_count; k++)); do
      if [[ "${lines[$((block_starts[0] + k))]}" != "${HEADER_LINES[$k]}" ]]; then
        matches=0
        break
      fi
    done
    ((matches)) && action="Unchanged"
  elif ((${#block_starts[@]} > 1)); then
    action="Updated"
  fi

  if [[ "$action" == "Unchanged" ]]; then
    echo "copyrighter: ${SYM_UNCHANGED} Unchanged ${type} header in '${file}' (already up to date)"
    ((++UNCHANGED_COUNT))
    return 0
  fi

  # rebuild the file's content with every detected header block removed
  local tail=() idx=$offset block_idx=0
  while ((idx < nlines)); do
    if ((block_idx < ${#block_starts[@]} && idx == block_starts[block_idx])); then
      idx=$((block_ends[block_idx] + 1))
      ((++block_idx))
      continue
    fi
    tail+=("${lines[$idx]}")
    ((++idx))
  done
  while ((${#tail[@]} > 0)) && [[ -z "${tail[0]}" ]]; do
    tail=("${tail[@]:1}")
  done

  local new_lines=()
  ((offset > 0)) && new_lines+=("${lines[@]:0:offset}")
  new_lines+=("${HEADER_LINES[@]}")
  new_lines+=("")
  ((${#tail[@]} > 0)) && new_lines+=("${tail[@]}")

  local symbol="$SYM_ADDED"
  [[ "$action" == "Updated" ]] && symbol="$SYM_UPDATED"
  NEEDS_HEADER_FILES+=("${file} (${action})")
  [[ "$action" == "Added" ]] && ((++ADDED_COUNT)) || ((++UPDATED_COUNT))

  if ((DRY_RUN)); then
    echo "copyrighter: ${symbol} [dry-run] ${action} ${type} header in '${file}'"
    return 0
  fi

  # Write the new header to a temporary file and replace the original file with it.
  local perms tmpfile
  perms=$(stat -c '%a' "$file" 2>/dev/null || echo "")
  tmpfile="${file}.copyrighter.tmp.$$"
  printf '%s\n' "${new_lines[@]}" > "$tmpfile"
  [[ -n "$perms" ]] && chmod "$perms" "$tmpfile"
  mv -- "$tmpfile" "$file"

  echo "copyrighter: ${symbol} ${action} ${type} header in '${file}'"
}

# process_path PATH - dispatch a single CLI argument to a file or directory walk.
process_path() {
  local target="$1"

  if [[ -f "$target" ]]; then
    if [[ -n "$FORCED_TYPE" ]]; then
      process_file "$target" "$FORCED_TYPE"
    else
      local detected
      detected="$(detect_type "$target")"
      if [[ -z "$detected" ]]; then
        echo "copyrighter: ${SYM_WARN} unable to determine file type for '${target}', use --type" >&2
        ((++SKIPPED_COUNT))
        return 0
      fi
      process_file "$target" "$detected"
    fi
    return 0
  fi

  if [[ -d "$target" ]]; then
    local f
    while IFS= read -r -d '' f; do
      process_file "$f" "$FORCED_TYPE"
    done < <(collect_files "$target" "$RECURSIVE")
    return 0
  fi

  echo "copyrighter: ${SYM_ERROR} '${target}' does not exist" >&2
  return 1
}

main() {
  local paths=()

  while (($# > 0)); do
    case "$1" in
      -t|--type)
          [[ $# -ge 2 ]] || { echo "copyrighter: ${SYM_ERROR} --type requires an argument" >&2; exit 1; }
          FORCED_TYPE="$2"
          if [[ ! " ${SUPPORTED_TYPES} " == *" ${FORCED_TYPE} "* ]]; then
            echo "copyrighter: ${SYM_ERROR} unknown type '${FORCED_TYPE}' (expected one of: ${SUPPORTED_TYPES})" >&2
            exit 1
          fi
          shift 2 ;;
      -r|--recursive|--full)
          RECURSIVE=1
          shift ;;
      -n|--dry-run|--check)
          DRY_RUN=1
          shift ;;
      -h|--help)
          usage
          exit 0 ;;
      --)
          shift
          while (($# > 0)); do paths+=("$1"); shift; done ;;
      -*)
          echo "copyrighter: ${SYM_ERROR} unknown option '$1'" >&2
          usage >&2
          exit 1 ;;
      *)
          paths+=("$1")
          shift ;;
    esac
  done

  if ((${#paths[@]} == 0)); then
    usage >&2
    exit 1
  fi

  local rc=0 p
  for p in "${paths[@]}"; do
    process_path "$p" || rc=1
  done

  if ((${#NEEDS_HEADER_FILES[@]} > 0)); then
    echo "copyrighter: ${SYM_SUMMARY} files needing a copyright header:"
    local entry
    for entry in "${NEEDS_HEADER_FILES[@]}"; do
      echo "  - ${entry}"
    done
    if ((DRY_RUN)); then rc=1; fi
  fi
  echo ""
  echo "  Run the script without -n|--dry-run|--check to actually apply changes."
  echo ""
  echo "copyrighter: ${SYM_SUMMARY} added ${ADDED_COUNT}, updated ${UPDATED_COUNT}, unchanged ${UNCHANGED_COUNT}, skipped ${SKIPPED_COUNT}"
  exit "$rc"
}

main "$@"
